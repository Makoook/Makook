generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum VerificationCodeType {
  EMAIL
  PHONE
}

enum MissionStatus {
  DRAFT
  OPEN
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id              String     @id @default(uuid())
  phone           String?    @unique
  email           String?    @unique
  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  status          UserStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roles             UserRole[]
  sessions          Session[]
  devices           Device[]
  verificationCodes VerificationCode[]
  missionsAsCustomer Mission[] @relation("CustomerMissions")
  missionsAsRunner Mission[] @relation("RunnerMissions")

  @@index([status])
  @@index([createdAt])
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  familyId         String
  refreshTokenHash String
  deviceId         String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  replacedBySessionId String?  @unique
  replacedBy          Session? @relation("SessionChain", fields: [replacedBySessionId], references: [id])
  replaces            Session? @relation("SessionChain")

  graceConsumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Device {
  id               String    @id @default(uuid())
  userId           String
  platform         String
  deviceIdentifier String?
  pushToken        String?
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpRequestLimit {
  id              String               @id @default(uuid())
  identifierHash  String
  type            VerificationCodeType
  windowStartedAt DateTime
  requestCount    Int                  @default(0)
  lastRequestedAt DateTime
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([identifierHash, type])
  @@index([windowStartedAt])
  @@index([lastRequestedAt])
}

model VerificationCode {
  id        String               @id @default(uuid())
  userId    String
  type      VerificationCodeType
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int                  @default(0)
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model Mission {
  id         String        @id @default(uuid())
  customerId String
  runnerId     String?
  quotedAmount Decimal?
  currency     String?
  status     MissionStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer User  @relation("CustomerMissions", fields: [customerId], references: [id], onDelete: Cascade)
  runner   User? @relation("RunnerMissions", fields: [runnerId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([customerId, createdAt])
  @@index([runnerId, status])
  @@index([status, createdAt])
}


enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  REFUNDED
  FAILED
  CANCELLED
}

enum PaymentIdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentWebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

model Payment {
  id                String        @id @default(uuid())
  missionId         String
  customerId        String
  amount            Decimal
  currency          String
  status            PaymentStatus @default(CREATED)
  provider          String?
  providerPaymentId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  mission             Mission                @relation(fields: [missionId], references: [id], onDelete: Restrict)
  idempotencyRecords PaymentIdempotency[]
  webhookEvents      PaymentWebhookEvent[]

  @@index([missionId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@unique([provider, providerPaymentId])
}

model PaymentIdempotency {
  id             String                   @id @default(uuid())
  key            String
  operation      String
  userId         String
  paymentId      String?
  requestHash    String
  status         PaymentIdempotencyStatus @default(PROCESSING)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([userId, key, operation])
  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}

model PaymentWebhookEvent {
  id              String               @id @default(uuid())
  provider        String
  providerEventId String
  eventType       String
  paymentId       String?
  payloadHash     String
  status          PaymentWebhookStatus @default(RECEIVED)
  receivedAt      DateTime             @default(now())
  processedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@index([status])
  @@index([receivedAt])
}
