generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum VerificationCodeType {
  EMAIL
  PHONE
}

model User {
  id              String     @id @default(uuid())
  phone           String?    @unique
  email           String?    @unique
  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  status          UserStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roles             UserRole[]
  sessions          Session[]
  devices           Device[]
  verificationCodes VerificationCode[]

  @@index([status])
  @@index([createdAt])
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  familyId         String
  refreshTokenHash String
  deviceId         String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  replacedBySessionId String?  @unique
  replacedBy          Session? @relation("SessionChain", fields: [replacedBySessionId], references: [id])
  replaces            Session? @relation("SessionChain")

  graceConsumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Device {
  id               String    @id @default(uuid())
  userId           String
  platform         String
  deviceIdentifier String?
  pushToken        String?
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpRequestLimit {
  id              String               @id @default(uuid())
  identifierHash  String
  type            VerificationCodeType
  windowStartedAt DateTime
  requestCount    Int                  @default(0)
  lastRequestedAt DateTime
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([identifierHash, type])
  @@index([windowStartedAt])
  @@index([lastRequestedAt])
}

model VerificationCode {
  id        String               @id @default(uuid())
  userId    String
  type      VerificationCodeType
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int                  @default(0)
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}
